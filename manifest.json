{
  "manifest_version": 3,
  "name": "Storyline Audio & Animation Bypass",
  "version": "0.1.0",
  "description": "Mutes Storyline media and reveals hidden slide objects.",
  "content_scripts": [
    {
      "matches": [
        "https://worldclasseduhub.vuca.co.za/*",
        "http://worldclasseduhub.vuca.co.za/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
