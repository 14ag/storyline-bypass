{
  "manifest_version": 3,
  "name": "Storyline Audio & Animation Bypass",
  "version": "0.1.0",
  "description": "Mutes Storyline audio and fast-forwards its slide timeline.",
  "content_scripts": [
    {
      "matches": [
        "https://worldclasseduhub.vuca.co.za/*",
        "http://worldclasseduhub.vuca.co.za/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
